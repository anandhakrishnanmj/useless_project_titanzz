<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sisyphus.io // Absolute Focus Challenge</title>

    <style>
        :root {
            --bg-color: #0d0d0d;
            --container-bg: #141414;
            --terminal-green: #00ff66;
            --terminal-green-dim: rgba(0, 255, 102, 0.15);
            --alert-red: #ff3344;
            --alert-red-glow: rgba(255, 51, 68, 0.6);
            --btn-base: #990011;
            --btn-shadow: #550005;
            --text-muted: #666;
            --border-dark: #333;
        }

        body {
            font-family: "Courier New", Courier, monospace;
            background-color: var(--bg-color);
            color: var(--terminal-green);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
            padding: 20px;
            box-sizing: border-box;
            transition: background-color 0.04s ease;
        }

        body.flash-trigger {
            background-color: var(--alert-red) !important;
        }

        .window-frame {
            text-align: center;
            padding: 35px 25px;
            border: 2px solid var(--border-dark);
            border-radius: 4px;
            background: var(--container-bg);
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.9);
            max-width: 420px;
            width: 100%;
            box-sizing: border-box;
        }

        h1 {
            margin-top: 0;
            font-size: 1.6rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        p.system-status-subtitle {
            color: #444;
            font-size: 0.8rem;
            margin-bottom: 25px;
            letter-spacing: 1px;
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
        }

        .auth-field {
            background: #000;
            border: 1px solid var(--border-dark);
            color: var(--terminal-green);
            font-family: inherit;
            font-size: 1rem;
            padding: 12px;
            width: 85%;
            margin-bottom: 5px;
            text-align: center;
            outline: none;
            box-sizing: border-box;
            border-radius: 4px;
            transition: border-color 0.15s ease;
        }

        .auth-field:focus-visible {
            border-color: var(--terminal-green);
            box-shadow: 0 0 8px var(--terminal-green-dim);
        }

        .auth-field.input-error {
            border-color: var(--alert-red) !important;
            box-shadow: 0 0 8px rgba(255, 51, 68, 0.2) !important;
        }

        .error-message-text {
            font-size: 0.75rem;
            color: var(--alert-red);
            height: 18px;
            margin-top: 4px;
            margin-bottom: 15px;
            visibility: hidden;
        }

        .lcd-display {
            background-color: #050505;
            padding: 25px 15px;
            border-radius: 4px;
            border: 1px solid #222;
            margin: 20px 0;
        }

        .main-tally {
            font-size: 5rem;
            font-weight: bold;
            color: var(--alert-red);
            text-shadow: 0 0 12px var(--alert-red-glow);
            line-height: 1;
        }

        .sub-header {
            font-size: 0.85rem;
            color: var(--text-muted);
            letter-spacing: 1px;
            margin-top: 8px;
            text-transform: uppercase;
        }

        .control-pad {
            margin: 30px 0;
            min-height: 85px;
        }

        .trigger-node {
            padding: 22px 0;
            font-size: 1.3rem;
            font-weight: bold;
            font-family: inherit;
            background-color: var(--btn-base);
            color: #fff;
            border: 1px solid var(--alert-red);
            border-radius: 6px;
            cursor: pointer;
            outline: none;
            position: relative;
            box-shadow: 0 6px 0 var(--btn-shadow);
            transition: transform 0.03s ease, box-shadow 0.03s ease;
            text-transform: uppercase;
            width: 100%;
            max-width: 240px;
            user-select: none;
            -webkit-user-select: none;
        }

        .trigger-node:active,
        .trigger-node.simulated-press {
            transform: translateY(3px);
            box-shadow: 0 3px 0 var(--btn-shadow);
        }

        .trigger-node.locked-housing {
            box-shadow: 0 0 0 var(--btn-shadow) !important;
            transform: translateY(6px) !important;
        }

        .trigger-node:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 4px;
        }

        .trigger-node:disabled {
            cursor: not-allowed;
            opacity: 0.55;
            filter: grayscale(0.4);
        }

        .log-box {
            font-size: 0.95rem;
            min-height: 55px;
            color: #888;
            line-height: 1.4;
            padding: 0 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }

            body {
                transition: none;
            }
        }
    </style>
</head>

<body>
    <div class="window-frame">

        <!-- Authentication screen -->
        <div id="authScreen" class="screen active">
            <h1>Identity Registry</h1>

            <p class="system-status-subtitle">
                [SECURE ACCESS CHANNEL]
            </p>

            <label for="username" class="sr-only">
                Enter Operator Tag. Minimum 3 characters.
            </label>

            <input
                type="text"
                id="username"
                class="auth-field"
                placeholder="OPERATOR TAG"
                autocomplete="off"
                maxlength="16"
            >

            <div id="usernameError" class="error-message-text">
                TAG MUST BE AT LEAST 3 CHARACTERS
            </div>

            <div style="margin-top: 5px;">
                <button
                    type="button"
                    id="loginBtn"
                    class="trigger-node"
                    style="font-size: 1rem; padding: 12px 0; max-width: 200px;"
                >
                    INITIALIZE
                </button>
            </div>
        </div>

        <!-- Main game screen -->
        <div id="gameScreen" class="screen">
            <h1 id="stageHeading">STAGE 01</h1>

            <div class="lcd-display">
                <div
                    class="main-tally"
                    id="scoreBoard"
                    aria-live="polite"
                >
                    0
                </div>

                <div class="sub-header" id="stageCondition">
                    TALLY ZONE ARCHETYPE A
                </div>
            </div>

            <div class="control-pad">
                <button
                    class="trigger-node"
                    id="actionBtn"
                    aria-describedby="feedbackLog"
                >
                    DEPRESS NODE
                </button>
            </div>

            <div
                class="log-box"
                id="feedbackLog"
                role="status"
                aria-live="polite"
            >
                System online. Submit unified impulse sequences.
            </div>
        </div>
    </div>

    <!-- Hidden critical alert channel -->
    <div
        class="sr-only"
        role="alert"
        aria-live="assertive"
        id="criticalAlertChannel"
    ></div>

    <script>
        (function () {
            "use strict";

            const ANIMATION_DURATION = 90;
            const RESET_DELAY = 150;

            let tally = 0;
            let activeStage = 1;
            let networkDebounce = false;

            const bodyNode = document.body;
            const authScreen = document.getElementById("authScreen");
            const gameScreen = document.getElementById("gameScreen");
            const loginBtn = document.getElementById("loginBtn");
            const usernameInput = document.getElementById("username");
            const usernameError = document.getElementById("usernameError");
            const actionBtn = document.getElementById("actionBtn");
            const scoreBoard = document.getElementById("scoreBoard");
            const stageHeading = document.getElementById("stageHeading");
            const stageCondition = document.getElementById("stageCondition");
            const feedbackLog = document.getElementById("feedbackLog");
            const criticalAlertChannel =
                document.getElementById("criticalAlertChannel");

            const stageMatrices = {
                1: {
                    threshold: 45,
                    baselineChance: 0.35,
                    curveScale: 0.15,
                    label: "TALLY ZONE ARCHETYPE A"
                },

                2: {
                    threshold: 90,
                    baselineChance: 0.28,
                    curveScale: 0.32,
                    label: "TALLY ZONE ARCHETYPE B"
                },

                3: {
                    threshold: 160,
                    baselineChance: 0.20,
                    curveScale: 0.55,
                    label: "TALLY ZONE ARCHETYPE C"
                },

                4: {
                    threshold: 240,
                    baselineChance: 0.12,
                    curveScale: 0.85,
                    label: "CLINICAL PURGE PARADIGM"
                },

                5: {
                    threshold: 350,
                    baselineChance: 0.04,
                    curveScale: 1.45,
                    label: "SISYPHUS MATRIX FAILURE"
                }
            };

            function getStageConfig() {
                return stageMatrices[activeStage];
            }

            function updateDisplay() {
                const stageConfig = getStageConfig();

                scoreBoard.textContent = tally;

                stageHeading.textContent =
                    `STAGE ${String(activeStage).padStart(2, "0")}`;

                stageCondition.textContent = stageConfig.label;
            }

            function showMessage(message, isAlert = false) {
                feedbackLog.textContent = message;

                if (isAlert) {
                    criticalAlertChannel.textContent = "";

                    setTimeout(() => {
                        criticalAlertChannel.textContent = message;
                    }, 10);
                }
            }

            function flashScreen() {
                const reducedMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;

                if (reducedMotion) {
                    return;
                }

                bodyNode.classList.add("flash-trigger");

                setTimeout(() => {
                    bodyNode.classList.remove("flash-trigger");
                }, RESET_DELAY);
            }

            function resetProgress(reason) {
                tally = 0;

                updateDisplay();
                flashScreen();

                actionBtn.disabled = true;
                actionBtn.classList.add("locked-housing");

                showMessage(reason, true);

                setTimeout(() => {
                    actionBtn.disabled = false;
                    actionBtn.classList.remove("locked-housing");
                    showMessage("System recovered. Continue the sequence.");
                }, RESET_DELAY);
            }

            function startGame() {
                const username = usernameInput.value.trim();

                if (username.length < 3) {
                    usernameInput.classList.add("input-error");
                    usernameError.style.visibility = "visible";
                    usernameInput.focus();
                    return;
                }

                usernameInput.classList.remove("input-error");
                usernameError.style.visibility = "hidden";

                authScreen.classList.remove("active");
                gameScreen.classList.add("active");

                showMessage(
                    `Operator ${username} authenticated. Begin sequence.`
                );

                updateDisplay();
                actionBtn.focus();
            }

            function calculateResetChance() {
                const stageConfig = getStageConfig();
                const progressRatio =
                    tally / stageConfig.threshold;

                return Math.min(
                    0.95,
                    stageConfig.baselineChance +
                    progressRatio * stageConfig.curveScale
                );
            }

            function advanceStageIfNeeded() {
                const stageConfig = getStageConfig();

                if (tally < stageConfig.threshold) {
                    return;
                }

                if (activeStage < 5) {
                    activeStage++;

                    showMessage(
                        `Stage transition confirmed. Entering Stage ${activeStage}.`
                    );

                    updateDisplay();
                } else {
                    showMessage(
                        "SISYPHUS MATRIX COMPLETE. Final threshold achieved.",
                        true
                    );

                    actionBtn.disabled = true;
                    actionBtn.textContent = "COMPLETE";
                }
            }

            function handleAction() {
                if (networkDebounce || actionBtn.disabled) {
                    return;
                }

                networkDebounce = true;

                tally++;
                updateDisplay();

                actionBtn.classList.add("simulated-press");

                setTimeout(() => {
                    actionBtn.classList.remove("simulated-press");
                }, ANIMATION_DURATION);

                const resetChance = calculateResetChance();

                if (Math.random() < resetChance) {
                    const failedAt = tally;

                    resetProgress(
                        `Sequence collapse detected at ${failedAt}. Progress reset.`
                    );
                } else {
                    const stability = Math.round(
                        (1 - resetChance) * 100
                    );

                    showMessage(
                        `Impulse accepted. Stability: ${stability}%.`
                    );

                    advanceStageIfNeeded();
                }

                setTimeout(() => {
                    networkDebounce = false;
                }, ANIMATION_DURATION);
            }

            loginBtn.addEventListener("click", startGame);

            usernameInput.addEventListener("keydown", (event) => {
                if (event.key === "Enter") {
                    startGame();
                }
            });

            usernameInput.addEventListener("input", () => {
                usernameInput.classList.remove("input-error");
                usernameError.style.visibility = "hidden";
            });

            actionBtn.addEventListener("click", handleAction);

            updateDisplay();
        })();
    </script>
</body>
</html>